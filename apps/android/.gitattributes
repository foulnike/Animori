# По умолчанию Git сам определяет текстовые файлы.
* text=auto

# Исходники проекта хранятся в LF.
*.ts   text eol=lf
*.mjs  text eol=lf
*.vue  text eol=lf
*.scss text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.rs   text eol=lf
*.toml text eol=lf
