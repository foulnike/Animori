{
  "name": "@animori/windows",
  "private": true,
  "version": "3.3.0",
  "type": "module",
  "description": "AniMori — Toolkit for AniList. Настольное приложение.",
  "license": "MIT",
  "author": "foulnike",
  "scripts": {
    "dev:app": "vite",
    "build:app": "npm run typecheck:all && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:shared": "vue-tsc --noEmit -p tsconfig.shared.json",
    "typecheck:all": "npm run typecheck:shared && vue-tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run --config ../../vitest.core.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
