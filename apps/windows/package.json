    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.11",
    "happy-dom": "^21.0.4",
    "typescript": "^5.6.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
