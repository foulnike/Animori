    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24",
    "@vitejs/plugin-vue": "^6.0.9",
    "happy-dom": "^20.12.0",
    "typescript": "^5.6.2",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.1.10"
  }
}
