{
  "name": "@animori/android-tv",
  "private": true,
  "version": "3.1.2",
  "type": "module",
  "description": "AniMori — Toolkit for AniList. Приложение для Android TV.",
  "license": "MIT",
  "author": "foulnike",
  "scripts": {
    "dev:app": "vite",
    "build:app": "npm run typecheck:all && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:shared": "vue-tsc --noEmit -p tsconfig.shared.json",
    "typecheck:all": "npm run typecheck:shared && vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
