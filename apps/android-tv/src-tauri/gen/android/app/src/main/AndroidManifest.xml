<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Обновление ставит само приложение: иначе APK привезти нечем. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <!-- Управление пультом, а не пальцем: сенсорный ввод не нужен вовсе.
         Без этого объявления магазин и лончер вправе счесть приложение
         непригодным для телевизора и не показать его. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Бэкапы выключены: animori-settings.json держит пропуск AniList, пропуск
         Яндекс Диска и пароль прокси шифром Android Keystore (SecretPlugin.kt). Ключ
         из Keystore не уходит, так что восстановленный шифртекст всё равно не
         открылся бы; копировать его незачем ни облаку Google, ни переносу на
         новое устройство. dataExtractionRules — для Android 12+, где allowBackup
         перенос между устройствами не закрывает. -->
    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.animori"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/banner"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
