<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" не закрывает перенос между устройствами, поэтому
     здесь исключено всё и для облачной копии, и для переноса. Ключ Keystore наружу не
     выходит в любом случае, но и шифртекст, и прочие настройки копировать незачем. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
